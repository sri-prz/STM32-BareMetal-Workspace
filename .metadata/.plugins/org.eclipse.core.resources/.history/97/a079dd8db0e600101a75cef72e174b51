//Where is the led connected?
//Port:  A
//Pin:   5

#define PERIPH_BASE				(0x40000000UL) //base of all peripherals
#define AHB1PERIPH_OFFSET		(0x00020000UL) //offset of the ahb1 bus
#define AHB1PERIPH_BASE	        (PERIPH_BASE + AHB1PERIPH_OFFSET) //base of ahb1 bus
#define GPIOA_OFFSET			(0x0000UL)

#define GPIOA_BASE				(AHB1PERIPH_BASE + GPIOA_OFFSET) //base of gpioa pin

#define RCC_OFFSET				(0x3800UL)
#define RCC_BASE				(AHB1PERIPH_BASE + RCC_OFFSET) //base of reset and clock control module


#define AHB1EN_R_OFFSET			(0x30UL)
#define RCC_AHB1EN_R            (*(volatile unsigned int *)(RCC_BASE +  AHB1EN_R_OFFSET))

#define MODE_R_OFFSET			(0x00UL)
#define GPIOA_MODE_R			(*(volatile unsigned int *)(GPIOA_BASE + MODE_R_OFFSET))


#define OD_R_OFFSET				(0x14UL)
#define GPIOA_OD_R				(*(volatile unsigned int *)(GPIOA_BASE +  OD_R_OFFSET))


#define  GPIOAEN				(1U<<0) //   0b 0000 0000 0000 0000 0000 0000 0000 0001		(0b signifies number is binary)

#define PIN5					(1U<<5)
#define LED_PIN					 PIN5


/*
 * (1U<<10)  // Set bit 10 to 1
 *  &=~(1U<<11) //  Set bit 11 to 0*/

//note: U means unsigned int (guaranteed min size of 16 bits) and UL means unsigned long (guaranteed min size of 32bits) - guranteed mins are based on c standards
//note (cont): for stm32f446 since the architecture is 32 bit both U and UL are 32 bits
//but its good practice to differentiate esp since UL is commonly used for memory addresses and U is used for flags and bitmasks (1U<<10)


//the mode register sets the function of the pin (input, general purpose output, alternate function, analog mode)
// |= is the bitwise or operator/
// ^= is the XOR operator

int main(void)
{
	/*1. Enable clock access to GPIOA*/
	RCC_AHB1EN_R  |=  GPIOAEN;

	/*2.Set PA5 as output pin*/
	GPIOA_MODE_R  |= (1U<<10);  // Set bit 10 to 1 using bitwise left shift operator (<<)
	GPIOA_MODE_R  &=~(1U<<11); //  Set bit 11 to 0

	while(1)
	{
		/*3.Set PA5 high*/
		//GPIOA_OD_R |= LED_PIN;

		/*4:Experiment 2 : toggle PA5*/
		GPIOA_OD_R ^= LED_PIN;
		for(int i=0;i<100000;i++){}

	}
}



